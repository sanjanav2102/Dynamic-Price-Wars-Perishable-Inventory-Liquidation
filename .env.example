# =========================================================
# AI configuration
# =========================================================

# Put your real OpenAI API key in .env
# NEVER commit the real key to Git.
OPENAI_API_KEY=

# Model used by the AI provider
OPENAI_MODEL=gpt-4o-mini

# Enable / disable LLM decisions
#
# false = deterministic rule-based simulation
# true  = OpenAI API with automatic fallback
AI_ENABLED=false

# Maximum API retries
AI_MAX_RETRIES=2

# API timeout in seconds
AI_TIMEOUT=10